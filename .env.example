# Copy to apps/api/.env for local overrides. All values are optional.
# Backend (read by apps/api, prefix SPECTRE_)
# SPECTRE_DATABASE_URL=sqlite:///./data/spectre.db
# SPECTRE_SCENARIOS_DIR=/absolute/path/to/scenarios
# SPECTRE_CORS_ORIGINS=["http://localhost:5173"]
# SPECTRE_MAX_SCENARIO_BYTES=1000000

# Frontend dev server proxy target (shell environment, read by apps/web/vite.config.ts)
# SPECTRE_API_URL=http://localhost:8000
